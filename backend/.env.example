# Copy this file to .env and change the values. NEVER commit .env.
# Names match app/core/config.py (docs/INTEGRATION_GUIDE.md section 7).
APP_ENV=development
DATABASE_URL=postgresql+psycopg2://school_user:CHANGE_ME@localhost:5432/school_db
JWT_SECRET_KEY=CHANGE_ME_LONG_RANDOM_STRING
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
CORS_ORIGINS=http://localhost:5000,http://localhost:3000
# Password given to the demo accounts created by the seed scripts (dev only)
SEED_DEFAULT_PASSWORD=CHANGE_ME
# --- member 2 ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5
FCM_ENABLED=false
FCM_CREDENTIALS_FILE=
